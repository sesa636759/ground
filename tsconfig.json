{
  "compilerOptions": {
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["dom", "es2022"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "baseUrl": ".",
    "paths": {
      "@service/*": ["src/service/*"],
      "@enterprise/ui-ground": ["./dist/ui-ground"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/components.d.ts"],
  "references": [
    {
      "path": "./projects/ui-anuglar-lib/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui-anuglar-lib/tsconfig.spec.json"
    }
  ]
}
